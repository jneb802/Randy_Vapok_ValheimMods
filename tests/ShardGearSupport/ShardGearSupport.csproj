<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>12</LangVersion>
    <PublicizeGameAssemblies>false</PublicizeGameAssemblies>
    <!-- The source under test deliberately replaces the same type in the reference assembly. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../EpicLoot/src/ShardStones/ShardSocketManager.cs" Link="ShardSocketManager.cs" />
    <Reference Include="EpicLoot" HintPath="$(EpicLootAssembly)" Publicize="true" />
    <Reference Include="$(GamePathManaged)/*.dll" />
    <Reference Include="$(BepinexPath)/core/*.dll" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <PackageReference Include="JotunnLib" Version="2.30.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <Target Name="RequirePaths" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(EpicLootAssembly)')" Text="Set EpicLootAssembly to a built EpicLoot.dll with the current shard APIs." />
    <Error Condition="!Exists('$(GamePathManaged)/assembly_valheim.dll')" Text="Set GamePathManaged to the Valheim Managed directory." />
  </Target>
</Project>
